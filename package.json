{
  "name": "rhythm-template",
  "version": "0.0.2",
  "private": true,
  "description": "Nest-style starter kit for Rhythm on Bun: module, controller, and service wired on the onion kernel.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:e2e": "bun test ./test/*.e2e-spec.ts",
    "lint": "oxlint src test",
    "fmt": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "fmt:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\"",
    "check": "bun run fmt:check && bun run lint && bun run typecheck"
  },
  "dependencies": {
    "@rhythmjs/rhythm": "^0.0.15",
    "@rhythmjs/router": "^0.0.14"
  },
  "devDependencies": {
    "@rhythmjs/testing": "^0.0.2",
    "@types/bun": "^1.2.0",
    "oxlint": "^1.0.0",
    "prettier": "^3.5.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
