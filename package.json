{
  "name": "rhythm-template",
  "version": "0.0.2",
  "private": true,
  "description": "Nest-style starter kit for Rhythm: module, controller, and service wired on the onion kernel.",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
